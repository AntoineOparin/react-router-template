{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.cloudflare.json" }],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Also declared here (not only in tsconfig.cloudflare.json) so tools like the shadcn CLI
    // that only read the root tsconfig resolve the `~/` alias.
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
