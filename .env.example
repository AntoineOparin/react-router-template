# Copy to `.env` and fill in. Never commit `.env`.
# Used by `npm run dev` (loaded into the local Worker) and by drizzle-kit (migrations).
# Production values are set with `npx wrangler secret put <NAME>` — see README.

# Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase dashboard → Connect → Session pooler (port 5432). Works on IPv4 networks.
# Used by drizzle-kit for migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Local dev only: what the HYPERDRIVE binding connects to during `npm run dev`.
# Usually the same value as DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
